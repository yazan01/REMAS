# Copy to .env and adjust per environment.
ENVIRONMENT=development
API_PREFIX=/api/v1

# SQLite for local dev; PostgreSQL for staging/production:
# DATABASE_URL=postgresql+psycopg://remas:remas@localhost:5432/remas
# DATABASE_URL=sqlite:///./remas.db

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=720
VERIFICATION_TOKEN_HOURS=48

MAX_UPLOAD_MB=25
DEFAULT_LOCALE=ar

# AI pipeline — optional. Without a key the deterministic provider is used,
# and the whole pipeline still runs (see services/ai/provider.py).
#
# These are the floor, not the last word: an administrator can select the
# provider and paste a key in the portal (Administration → Artificial
# intelligence), and that stored value wins over anything set here. Setting a
# key here suits a deployment that manages secrets outside the database.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Only for an OpenAI-compatible gateway (Azure OpenAI, an internal proxy):
# OPENAI_BASE_URL=
AI_MODEL=claude-sonnet-5
AI_ENABLED=true

# Which framework "current" resolves to when several are published (FR-32)
DEFAULT_FRAMEWORK_CODE=REMAS

# ── security (mandatory outside development) ──────────────────────────
# Generate with: python -m app.core.keygen
# JWT_SECRET must be >= 32 bytes. Both may be supplied as files instead:
#   JWT_SECRET_FILE=/run/secrets/jwt
#   EVIDENCE_MASTER_KEY_FILE=/run/secrets/evidence
# JWT_SECRET=
# EVIDENCE_MASTER_KEY=
ENCRYPT_EVIDENCE=true

# ── OCR for scanned documents (AI-01 / AI-07) ─────────────────────────
OCR_PROVIDER=auto            # auto | tesseract | azure | openai | none
OCR_LANGUAGES=ara+eng
OCR_MIN_CONFIDENCE=0.6
# OCR_ENDPOINT=
# OCR_API_KEY=
# TESSERACT_CMD=

# ── operations ────────────────────────────────────────────────────────
METRICS_ENABLED=true
# BACKUP_DIR=

# ── OCR language models ───────────────────────────────────────────────
# Arabic is not part of a default Tesseract install. Download once:
#   curl -L -o tessdata/ara.traineddata \
#     https://github.com/tesseract-ocr/tessdata_best/raw/main/ara.traineddata
# TESSDATA_DIR defaults to backend/tessdata
OCR_MIN_PLAUSIBILITY=0.55
